  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true, "useUnknownInCatchVariables": false, "skipLibCheck": true,
    "types": ["node"], "rewriteRelativeImportExtensions": true
