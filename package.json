{
  "name": "dsh-memory",
  "version": "1.2.2",
  "private": true,
  "description": "Durable project and global memory for DeepSeek Harness, with context injection, revision-guarded tools and history.",
  "license": "MIT",
  "author": "Igor Karpliuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalikco/dsh-memory.git"
  },
  "homepage": "https://github.com/nalikco/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/nalikco/dsh-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "memory"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "mapping.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "migrate": "node dist/migrate.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
